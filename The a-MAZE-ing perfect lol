function maze_game()
  %GLOBAL CONFIGURATION OF THE GAME%
  % STEP 1: Close any old game window (fixes blocking on the 2nd launch).
  close all force;
  try, graphics_toolkit('qt'); catch, end

  % STEP 2: Defining the game parameters. Start is always (1,1).
  % The grid size and the goal depend on the level (see level_settings and new_maze).
  g.N = 10;              % grid size (changes with the level)
  g.start = [1 1];       % start position [row column]
  g.goal = [10 10];      % goal position (always the bottom-right corner)
  g.mode = 'intro';      % screens: 'intro', 'menu', 'play', 'end', 'victory'
  g.won = false;
  g.level = 1;           % current level (1 to 8)
  g.maxlevel = 8;        % number of levels in the game
  g.layout = 'AZERTY';   % keyboard layout: 'AZERTY' or 'QWERTY'
  g.enemies = zeros(0, 2);   % current enemy positions [row column], one line per enemy
  g.enemies0 = zeros(0, 2);  % enemy start positions (used when we restart the same maze)
  g.chase = 0;               % chance (0 to 1) that an enemy moves toward the player
  g.nStart = 6;          % number of start screens (start1 to start6)
  g.introIdx = 1;        % which start screen is shown now (changes with SPACE)
  g.lastmsg = '';        % last message shown in the title (used when we redraw)

  % STEP 3: Loading the images BEFORE creating the window,
  % so a missing image never leaves a half-created window open.
  % Names are given without extension: load_img finds .png, .jpg or .jpeg by itself.
  % All the images must be in the same folder as this file.
  folder = fileparts(mfilename('fullpath'));
  % The 6 start screens: start1, start2, ... start6
  g.startImgs = cell(1, g.nStart);
  for i = 1:g.nStart
    g.startImgs{i} = load_img(folder, sprintf('start%d', i));
  end
  % Player that moves from start to goal
  [g.playerImg, g.playerAlpha] = load_img(folder, 'player');
  % Grass background
  g.grassImg = load_img(folder, 'grass_background');
  % Hedge walls that function as the blocking obstacles
  [g.hedgeImg, g.hedgeAlpha] = load_img(folder, 'hedge');
  % Enemies (if one touches the player, the player loses)
  [g.enemyImg, g.enemyAlpha] = load_img(folder, 'enemy');
  % The goal cell (the end of the maze)
  [g.endImg, g.endAlpha] = load_img(folder, 'end');

  % STEP 4: Creation of the window and connecting the keyboard to on_key.
  fig = figure('Name', 'a-MAZE-ing', 'NumberTitle', 'off', 'MenuBar', 'none', ...
               'KeyPressFcn', @on_key);
  setappdata(fig, 'g', g);

  % STEP 5: Show the first start screen.
  show_intro(fig);
end

function [img, alpha] = load_img(folder, name)
  % STEP 6: Read an image file given WITHOUT extension (for example 'start1').
  % It tries .png, then .jpg, then .jpeg. If none exists, it shows a clear message.
  % alpha = transparency of the PNG (empty for a jpeg, which has no transparency).
  extensions = {'.png', '.jpg', '.jpeg'};
  for e = 1:length(extensions)
    file = fullfile(folder, [name extensions{e}]);
    if exist(file, 'file')
      [img, ~, alpha] = imread(file);
      return;
    end
  end
  error('Image not found: %s (.png, .jpg or .jpeg) in the folder %s', name, folder);
end

function [N, density, extra, nEnemies, chase] = level_settings(level)
  % STEP 7: Setting the difficulty of each level (8 levels).
  % N        = grid size (bigger grid = longer way to the goal)
  % density  = share of cells that are hedge (more hedge = harder)
  % extra    = steps allowed on top of the shortest path (fewer = harder)
  % nEnemies = number of enemies on the grid
  % chase    = chance that an enemy walks toward the player instead of randomly
  Ns        = [10   10   11   11   12   12   13   13  ];
  densities = [0.17 0.20 0.23 0.26 0.28 0.30 0.32 0.33];
  extras    = [14   13   12   12   11   10   10   9   ];
  enemies   = [0    1    1    2    2    3    3    4   ];
  chases    = [0    0.2  0.3  0.3  0.4  0.4  0.5  0.5 ];
  N = Ns(level);
  density = densities(level);
  extra = extras(level);
  nEnemies = enemies(level);
  chase = chases(level);
end

function k = get_keys(layout)
  % STEP 8: Defining the control movement keys depending on the keyboard layout.
  if strcmp(layout, 'AZERTY')
    k.up = 'z'; k.left = 'q'; k.down = 's'; k.right = 'd';
  else
    k.up = 'w'; k.left = 'a'; k.down = 's'; k.right = 'd';
  end
end

function g = switch_layout(g)
  % STEP 9: Switch between AZERTY and QWERTY.
  if strcmp(g.layout, 'AZERTY')
    g.layout = 'QWERTY';
  else
    g.layout = 'AZERTY';
  end
end

%SETUP OF THE SCREENS%
function clear_fig(fig)
  % Remove everything drawn in the window but keep the keyboard connection.
  delete(get(fig, 'children'));
end

function show_intro(fig)
  % STEP 10: Start screen = one of the images start1 ... start6.
  % The image number is g.introIdx. SPACE goes to the next one (see on_key).
  g = getappdata(fig, 'g');
  clear_fig(fig);
  ax = axes('Parent', fig, 'Position', [0 0 1 1]);
  image(g.startImgs{g.introIdx}, 'Parent', ax);
  axis(ax, 'image');        % keep the real proportions of the picture
  axis(ax, 'off');
  drawnow;
end

function show_menu(fig)
  % STEP 11: Level menu. Keys 1 to 8 choose the level.
  clear_fig(fig);
  axes('Parent', fig, 'Position', [0 0 1 1]); axis off;
  text(0.5, 0.85, 'LEVEL MENU', 'HorizontalAlignment', 'center', ...
       'FontSize', 24, 'FontWeight', 'bold');
  items = {'Press 1 to 8 to choose a level', ...
           'Level 8 is the hardest', ...
           '', ...
           'Higher levels = bigger maze, more hedges, more enemies.', ...
           '', ...
           'H = back to the start screen'};
  text(0.5, 0.5, items, 'HorizontalAlignment', 'center', 'FontSize', 16);
  drawnow;
end

function show_victory(fig)
  % STEP 12: Final screen shown after beating the last level.
  % Congratulations message, confetti and a golden trophy.
  g = getappdata(fig, 'g');
  clear_fig(fig);
  ax = axes('Parent', fig, 'Position', [0 0 1 1]);
  hold(ax, 'on');
  set(ax, 'Color', [0.08 0.10 0.25]);          % dark night-blue background
  xlim(ax, [0 1]); ylim(ax, [0 1]);
  axis off;

  gold = [1 0.84 0];
  darkgold = [0.75 0.55 0];

  % Confetti: random colored dots spread over the whole screen
  nConf = 90;
  scatter(rand(1, nConf), rand(1, nConf), 45, rand(nConf, 3), 'filled');

  % Trophy handles (drawn first so the cup covers their inner side)
  rectangle('Position', [0.30 0.50 0.11 0.10], 'Curvature', [1 1], ...
            'EdgeColor', darkgold, 'LineWidth', 7, 'FaceColor', 'none');
  rectangle('Position', [0.59 0.50 0.11 0.10], 'Curvature', [1 1], ...
            'EdgeColor', darkgold, 'LineWidth', 7, 'FaceColor', 'none');

  % Trophy cup: half ellipse with a flat top
  t = linspace(pi, 2*pi, 50);
  cupX = 0.5 + 0.14 * cos(t);
  cupY = 0.64 + 0.22 * sin(t);
  patch(cupX, cupY, gold, 'EdgeColor', darkgold, 'LineWidth', 2);

  % Shine on the cup and a star in the middle
  plot([0.40 0.41 0.44], [0.60 0.55 0.50], 'Color', [1 1 0.8], 'LineWidth', 4);
  plot(0.5, 0.56, 'p', 'MarkerSize', 26, 'MarkerFaceColor', [1 1 1], ...
       'MarkerEdgeColor', darkgold);

  % Trophy stem and base
  rectangle('Position', [0.47 0.35 0.06 0.09], 'FaceColor', gold, ...
            'EdgeColor', darkgold, 'LineWidth', 2);
  rectangle('Position', [0.40 0.30 0.20 0.05], 'FaceColor', gold, ...
            'EdgeColor', darkgold, 'LineWidth', 2);
  rectangle('Position', [0.35 0.26 0.30 0.04], 'FaceColor', darkgold, ...
            'EdgeColor', darkgold, 'LineWidth', 2);

  % Stars around the trophy
  plot([0.18 0.82 0.12 0.88], [0.62 0.62 0.40 0.40], 'p', 'MarkerSize', 20, ...
       'MarkerFaceColor', gold, 'MarkerEdgeColor', darkgold);

  % Messages
  text(0.5, 0.93, 'CONGRATULATIONS!', 'HorizontalAlignment', 'center', ...
       'FontSize', 32, 'FontWeight', 'bold', 'Color', gold);
  text(0.5, 0.84, 'You escaped the maze!', 'HorizontalAlignment', 'center', ...
       'FontSize', 20, 'Color', [1 1 1]);
  text(0.5, 0.74, sprintf('All %d levels completed - you are the a-MAZE-ing champion!', ...
       g.maxlevel), 'HorizontalAlignment', 'center', 'FontSize', 13, ...
       'FontAngle', 'italic', 'Color', [0.8 0.9 1]);
  text(0.5, 0.17, sprintf('SPACE = play again from level 1    R = replay level %d', ...
       g.maxlevel), 'HorizontalAlignment', 'center', 'FontSize', 12, 'Color', [1 1 1]);
  text(0.5, 0.11, 'M = level menu    H = start screen', ...
       'HorizontalAlignment', 'center', 'FontSize', 12, 'Color', [1 1 1]);
  text(0.5, 0.04, 'Created by Andrea and Berenice', 'HorizontalAlignment', 'center', ...
       'FontSize', 10, 'FontAngle', 'italic', 'Color', [0.7 0.7 0.8]);
  hold(ax, 'off');
  drawnow;
end

%MAZE DESIGN%
function draw_game(fig, msg)
  % STEP 13: Draw the grass, hedges, start/goal, enemies, player and the help text.
  g = getappdata(fig, 'g');
  g.lastmsg = msg;                  % remember the message (used when L redraws the screen)
  setappdata(fig, 'g', g);
  k = get_keys(g.layout);
  clear_fig(fig);
  % The game area leaves some free space at the bottom for the help text
  ax = axes('Parent', fig, 'Position', [0.1 0.17 0.8 0.73]);
  hold on;
  % The grass background that fills the whole grid
  image([0.5 g.N + 0.5], [0.5 g.N + 0.5], g.grassImg);
  % The hedge walls (where walls == 1)
  for r = 1:g.N
    for c = 1:g.N
      if g.walls(r, c) == 1
        hHedge = image([c-0.5 c+0.5], [r-0.5 r+0.5], g.hedgeImg);
        if ~isempty(g.hedgeAlpha)
          set(hHedge, 'AlphaData', g.hedgeAlpha); % PNG transparency
        end
      end
    end
  end

  % STEP 14: Start cell = light blue square, goal cell = the image end.
  patch(g.start(2)+[-0.5 0.5 0.5 -0.5], g.start(1)+[-0.5 -0.5 0.5 0.5], ...
        [0.4 0.7 1], 'FaceAlpha', 0.4, 'EdgeColor', 'none');
  hEnd = image([g.goal(2)-0.5 g.goal(2)+0.5], [g.goal(1)-0.5 g.goal(1)+0.5], g.endImg);
  if ~isempty(g.endAlpha)
    set(hEnd, 'AlphaData', g.endAlpha);
  end

  % STEP 15: The enemies = the image enemy (one per line of g.enemies).
  for e = 1:size(g.enemies, 1)
    er = g.enemies(e, 1); ec = g.enemies(e, 2);
    hEnemy = image([ec-0.4 ec+0.4], [er-0.4 er+0.4], g.enemyImg);
    if ~isempty(g.enemyAlpha)
      set(hEnemy, 'AlphaData', g.enemyAlpha);
    end
  end

  % STEP 16: The player
  r = g.player(1); c = g.player(2);
  hPlayer = image([c-0.45 c+0.45], [r-0.45 r+0.45], g.playerImg);
  if ~isempty(g.playerAlpha)
    set(hPlayer, 'AlphaData', g.playerAlpha);
  end

  % Axes configuration
  axis(ax, 'equal');
  axis(ax, [0.5 g.N+0.5 0.5 g.N+0.5]);
  set(ax, 'YDir', 'reverse');
  axis(ax, 'off');
  hold off;

  % Display level info, remaining steps and number of enemies
  title(ax, {sprintf('Level %d   Steps left: %d   Enemies: %d', g.level, ...
                     g.maxsteps - g.steps, size(g.enemies, 1)), msg}, 'FontSize', 13);

  % STEP 17: Help text under the game (keyboard style, how to change it, menu, start screen).
  % Units 'normalized' = position relative to the game area (y < 0 means below it).
  help = {sprintf('Keyboard: %s (%s = up, %s = left, %s = down, %s = right)   -   L = switch AZERTY / QWERTY', ...
                  g.layout, upper(k.up), upper(k.left), upper(k.down), upper(k.right)), ...
          'M = level menu   |   H = back to the start screen'};
  text(0.5, -0.03, help, 'Parent', ax, 'Units', 'normalized', ...
       'HorizontalAlignment', 'center', 'VerticalAlignment', 'top', 'FontSize', 10);
  drawnow;
end

function g = new_maze(g)
  % STEP 18: Make the maze of the current level.
  % 0 = open grass, 1 = hedge (obstacle). Retry until a path exists (always solvable).
  [N, density, extra, nEnemies, chase] = level_settings(g.level);
  g.N = N;                 % grid size of this level
  g.goal = [N N];          % goal = bottom-right corner
  g.chase = chase;         % how smart the enemies are at this level
  while true
    walls = rand(g.N) < density;              % position of the obstacles
    walls(g.start(1), g.start(2)) = 0;        % start point must be open grass
    walls(g.goal(1), g.goal(2)) = 0;          % goal must be open grass
    d = shortest_path(walls, g.start, g.goal);
    if d > 0                                  % d > 0 means a path exists
      break;
    end
  end
  g.walls = walls;
  % Step limit = shortest path + extra steps, so winning is always possible without enemies.
  g.maxsteps = d + extra;

  % STEP 19: Place the enemies on random open cells.
  % They must be at least 5 cells away from the start (Manhattan distance),
  % so the player never loses at the very first move, and not on the goal.
  if nEnemies > 0
    [rr, cc] = find(walls == 0);
    far = (abs(rr - g.start(1)) + abs(cc - g.start(2)) >= 5) & ...
          ~(rr == g.goal(1) & cc == g.goal(2));
    rr = rr(far); cc = cc(far);
    pick = randperm(length(rr), min(nEnemies, length(rr)));
    g.enemies0 = [rr(pick) cc(pick)];
  else
    g.enemies0 = zeros(0, 2);
  end
  g.enemies = g.enemies0;
end

function d = shortest_path(walls, start, goal)
  % STEP 20: Breadth-first search. Returns shortest path length, or -1 if none.
  N = size(walls, 1);
  dist = -ones(N);
  dist(start(1), start(2)) = 0;
  queue = start;
  moves = [1 0; -1 0; 0 1; 0 -1];
  while ~isempty(queue)
    cur = queue(1, :);
    queue(1, :) = [];
    for m = 1:4
      nxt = cur + moves(m, :);
      if all(nxt >= 1) && all(nxt <= N) && walls(nxt(1), nxt(2)) == 0 ...
         && dist(nxt(1), nxt(2)) == -1
        dist(nxt(1), nxt(2)) = dist(cur(1), cur(2)) + 1;
        queue(end+1, :) = nxt;
      end
    end
  end
  d = dist(goal(1), goal(2));
end

function g = move_enemies(g)
  % STEP 21: Each enemy makes one step. Called after every valid move of the player.
  % An enemy cannot go through hedges, leave the grid or step on the goal.
  % With probability g.chase it walks toward the player, otherwise it walks randomly.
  moves = [1 0; -1 0; 0 1; 0 -1];
  for e = 1:size(g.enemies, 1)
    options = zeros(0, 2);                    % list of cells the enemy can go to
    for m = 1:4
      nxt = g.enemies(e, :) + moves(m, :);
      if all(nxt >= 1) && all(nxt <= g.N) && g.walls(nxt(1), nxt(2)) == 0 ...
         && ~isequal(nxt, g.goal)
        options(end+1, :) = nxt;
      end
    end
    if isempty(options)
      continue;                               % enemy is stuck, it stays here
    end
    if rand < g.chase
      % Choose the option closest to the player (Manhattan distance)
      dists = abs(options(:, 1) - g.player(1)) + abs(options(:, 2) - g.player(2));
      [~, best] = min(dists);
      g.enemies(e, :) = options(best, :);
    else
      % Choose a random option
      g.enemies(e, :) = options(randi(size(options, 1)), :);
    end
  end
end

function hit = enemy_touch(g)
  % STEP 22: true if at least one enemy is on the same cell as the player.
  hit = any(g.enemies(:, 1) == g.player(1) & g.enemies(:, 2) == g.player(2));
end

function g = reset_player(g)
  % STEP 23: Put the player and the enemies back at the start with 0 steps used.
  g.player = g.start;
  g.enemies = g.enemies0;
  g.steps = 0;
  g.mode = 'play';
end

%KEYBOARD HANDLE%
function on_key(src, evt)
  % STEP 24: Read the pressed key (as lowercase text).
  g = getappdata(src, 'g');
  if isempty(g) || ~isstruct(g), return; end   % window without game data: do nothing
  key = evt.Key;
  if isempty(key), key = evt.Character; end
  if isempty(key), return; end
  if strcmp(key, ' '), key = 'space'; end
  if length(key) > 1 && strncmp(key, 'numpad', 6), key = key(end); end  % keypad numbers
  key = lower(key);
  k = get_keys(g.layout);

  % STEP 25: H goes back to the first start screen, M opens the level menu.
  if strcmp(key, 'h') && ~strcmp(g.mode, 'intro')
    g.mode = 'intro';
    g.introIdx = 1;
    setappdata(src, 'g', g);
    show_intro(src);
    return;
  elseif strcmp(key, 'm') && ~strcmp(g.mode, 'menu')
    g.mode = 'menu';
    setappdata(src, 'g', g);
    show_menu(src);
    return;
  end

  % STEP 26: L switches AZERTY / QWERTY while playing (the help text under the game updates).
  if strcmp(key, 'l') && any(strcmp(g.mode, {'play', 'end'}))
    g = switch_layout(g);
    setappdata(src, 'g', g);
    draw_game(src, g.lastmsg);
    return;
  end

  switch g.mode
    case 'intro'
      % STEP 27: SPACE shows the next start image (start1 -> start2 -> ... -> start6).
      % After the last one, SPACE starts level 1.
      if strcmp(key, 'space')
        if g.introIdx < g.nStart
          g.introIdx = g.introIdx + 1;
          setappdata(src, 'g', g);
          show_intro(src);
        else
          g.level = 1;
          g = new_maze(g);
          g = reset_player(g);
          setappdata(src, 'g', g);
          draw_game(src, '');
        end
      end

    case 'menu'
      % STEP 28: Keys 1 to 8 start the chosen level with a new random maze.
      if any(strcmp(key, {'1', '2', '3', '4', '5', '6', '7', '8'}))
        g.level = str2double(key);
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      end

    case 'play'
      % STEP 29: Movement keys move the player by exactly one cell.
      if strcmp(key, k.up),        d = [-1 0];
      elseif strcmp(key, k.down),  d = [1 0];
      elseif strcmp(key, k.left),  d = [0 -1];
      elseif strcmp(key, k.right), d = [0 1];
      else, return;
      end
      nxt = g.player + d;
      moved = false;
      % A move is valid only if it stays inside the grid and is not a wall.
      if all(nxt >= 1) && all(nxt <= g.N) && g.walls(nxt(1), nxt(2)) == 0
        g.player = nxt;
        g.steps = g.steps + 1;
        moved = true;
      end

      % STEP 30: Find out what happened. Order of the checks:
      % 1) player on the goal = win, 2) player walked into an enemy = lose,
      % 3) enemies move, then enemy on the player = lose, 4) no steps left = lose.
      outcome = 'continue';
      if isequal(g.player, g.goal)
        outcome = 'win';
      elseif enemy_touch(g)
        outcome = 'caught';
      else
        if moved
          g = move_enemies(g);
        end
        if enemy_touch(g)
          outcome = 'caught';
        elseif g.steps >= g.maxsteps
          outcome = 'timeout';
        end
      end

      % STEP 31: React to the result.
      switch outcome
        case 'win'
          g.won = true;
          if g.level < g.maxlevel
            g.mode = 'end';
            setappdata(src, 'g', g);
            draw_game(src, 'WINNER!  R = again | N = new game | I = next level');
          else
            % Last level beaten: show the final congratulations screen with the trophy.
            g.mode = 'victory';
            setappdata(src, 'g', g);
            show_victory(src);
          end
        case 'caught'
          g.mode = 'end'; g.won = false;
          setappdata(src, 'g', g);
          draw_game(src, 'LOOSER - an enemy caught you!  R = start again');
        case 'timeout'
          g.mode = 'end'; g.won = false;
          setappdata(src, 'g', g);
          draw_game(src, 'LOOSER - no steps left  R = start again');
        otherwise
          setappdata(src, 'g', g);
          draw_game(src, '');
      end

    case 'end'
      if strcmp(key, 'r')
        % STEP 32: R = same maze, player and enemies back to their start.
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      elseif strcmp(key, 'n') && g.won
        % STEP 33: N = new random walls, same level, same start and goal.
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      elseif strcmp(key, 'i') && g.won && g.level < g.maxlevel
        % STEP 34: I = go to the next level (only after a win).
        g.level = g.level + 1;
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      end

    case 'victory'
      % STEP 35: Controls of the final screen.
      % SPACE = new game from level 1, R = replay the last level (new random walls).
      % (H and M are already handled above for every screen.)
      if strcmp(key, 'space')
        g.level = 1;
        g.won = false;
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      elseif strcmp(key, 'r')
        g.level = g.maxlevel;
        g.won = false;
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      end
  end
end
