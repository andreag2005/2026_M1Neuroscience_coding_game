function maze_game()
  %GLOBAL CONFIGURATION OF THE GAME%
  % STEP 1: Close any old game window (fixes blocking on the 2nd launch).
  close all force;
  try, graphics_toolkit('qt'); catch, end

  % STEP 2: Definining the game parameters. Start is always (1,1), goal is always (10,10).
  g.N = 10;              % grid size (10 x 10)
  g.start = [1 1];       % start position [row column]
  g.goal = [10 10];      % goal position (same in every level)
  g.mode = 'intro';      % screens: 'intro', 'menu', 'play', 'end'
  g.won = false;
  g.level = 1;           % current level (1 to 5)
  g.layout = 'AZERTY';   % keyboard layout: 'AZERTY' or 'QWERTY'

  % STEP 3: Creation of the window and connecting the keyboard to on_key.
  fig = figure('Name', 'a-MAZE-ing', 'NumberTitle', 'off', 'MenuBar', 'none', ...
               'KeyPressFcn', @on_key);

  % STEP 4: Loading the images.
  folder = fileparts(mfilename('fullpath'));
  % Player that moves from start to goal
  [g.playerImg, ~, g.playerAlpha] = imread(fullfile(folder, 'player.png'));
  % Grass background
  g.grassImg = imread(fullfile(folder, 'grass_background.png'));
  % Hedge walls that function as the blocking obstacles
  [g.hedgeImg, ~, g.hedgeAlpha] = imread(fullfile(folder, 'hedge.png'));
  setappdata(fig, 'g', g);

  % STEP 4: Show the start screen.
  show_intro(fig);
end

function [density, extra] = level_settings(level)
  % STEP 5: Setting the difficulty of each level.
  % density = share of cells that are hedge (more hedge = harder).
  % extra   = steps allowed on top of the shortest path (fewer = harder).
  densities = [0.17 0.23 0.30 0.34 0.39];
  extras    = [7    5    3    2    1   ];
  density = densities(level);
  extra = extras(level);
end

function k = get_keys(layout)
  % STEP 6: Defining the control movement keys depending on the keyboard layout.
  if strcmp(layout, 'AZERTY')
    k.up = 'z'; k.left = 'q'; k.down = 's'; k.right = 'd';
  else
    k.up = 'w'; k.left = 'a'; k.down = 's'; k.right = 'd';
  end
end

 %SETUP OF THE INTRODUCTION SCREEN%
 function clear_fig(fig)
  % Remove everything drawn in the window but keep the keyboard connection.
  delete(get(fig, 'children'));
end
function show_intro(fig)
  % STEP 7: Start screen with title, credits and rules.
  g = getappdata(fig, 'g');
  k = get_keys(g.layout);
  clear_fig(fig);
  axes('Parent', fig, 'Position', [0 0 1 1]); axis off;
  text(0.5, 0.92, 'a-MAZE-ing', 'HorizontalAlignment', 'center', ...
       'FontSize', 28, 'FontWeight', 'bold');
  text(0.5, 0.84, 'Created by Andrea and Berenice', 'HorizontalAlignment', 'center', ...
       'FontSize', 12, 'FontAngle', 'italic');
  rules = {'RULES', ...
           '', ...
           sprintf('Move the player with %s (up), %s (left), %s (down), %s (right).', ...
                   upper(k.up), upper(k.left), upper(k.down), upper(k.right)), ...
           'Help the person scape the maze. You move one step at a time. You can`t cross the hedges.', ...
           'Reach the RED square before you run out of steps.', ...
           'If you reach it: WINNER!  If not: LOOSER.', ...
           'There are 5 levels, from easy to very hard.', ...
           '', ...
           'R = start again (same maze)    N = new game (new random obstacles)', ...
           'I = next level (only after a win)', ...
           'M = level menu    H = back to this screen', ...
           '', ...
           sprintf('Keyboard: %s   (press L to switch AZERTY / QWERTY)', g.layout), ...
           '', ...
           'Press SPACE to start'};
  text(0.5, 0.42, rules, 'HorizontalAlignment', 'center', 'FontSize', 12);
  drawnow;
end

function show_menu(fig)
  % STEP 8: Set the level menu. The player presses 1 to 5 to choose a level with increasing difficulty.
  clear_fig(fig);
  axes('Parent', fig, 'Position', [0 0 1 1]); axis off;
  text(0.5, 0.88, 'LEVEL MENU', 'HorizontalAlignment', 'center', ...
       'FontSize', 24, 'FontWeight', 'bold');
  items = {'1 - Easy', '2 - Medium', '3 - Hard', '4 - Harder', '5 - Very hard', ...
           '', 'Press 1 to 5 to choose a level', 'H = back to the start screen'};
  text(0.5, 0.45, items, 'HorizontalAlignment', 'center', 'FontSize', 16);
  drawnow;
end

 %MAZE DESIGN%
function draw_game(fig, msg)
  % STEP 9: Configure the grass background and the hedge walls in our matrix.
  g = getappdata(fig, 'g');
  clear_fig(fig);
  axes('Parent', fig);
  hold on;
  %The grass background that fills the whole grid
  image([0.5 g.N + 0.5], [0.5 g.N + 0.5], g.grassImg);
  %The hedge walls (where walls ==1 )
  for r = 1:g.N
    for c = 1:g.N
      if g.walls(r, c) == 1
        hHedge = image([c-0.5 c+0.5], [r-0.5 r+0.5], g.hedgeImg);
        if isfield(g, 'hedgeAlpha') && ~isempty(g.hedgeAlpha)
          set(hHedge, 'AlphaData', g.hedgeAlpha); % PNG transparency
        end
      end
    end
  end

  %STEP 10: Configure the marker for the start and goal cells.
  % Start cell = light blue = start, Goal cell = red
  patch(g.start(2)+[-0.5 0.5 0.5 -0.5], g.start(1)+[-0.5 -0.5 0.5 0.5], ...
        [0.4 0.7 1], 'FaceAlpha', 0.4, 'EdgeColor', 'none');
  patch(g.goal(2)+[-0.5 0.5 0.5 -0.5], g.goal(1)+[-0.5 -0.5 0.5 0.5], ...
        [1 0 0], 'FaceAlpha', 0.5, 'EdgeColor', 'none');

  %STEP 11: Configure the player position
 r = g.player(1); c = g.player(2);
  hPlayer = image([c-0.45 c+0.45], [r-0.45 r+0.45], g.playerImg);
  if ~isempty(g.playerAlpha)
    set(hPlayer, 'AlphaData', g.playerAlpha);
  end

  %STEP 12: Axes configuration
  axis equal;
  axis([0.5 g.N+0.5 0.5 g.N+0.5]);
  set(gca, 'YDir', 'reverse');
  axis off;
  hold off;

  %STEP 13: Display level info and remaining steps
  title({sprintf('Level %d   Steps left: %d', g.level, g.maxsteps - g.steps), msg}, ...
        'FontSize', 13);
  drawnow;
  title({sprintf('Level %d   Steps left: %d', g.level, g.maxsteps - g.steps), msg}, ...
        'FontSize', 13);
  drawnow;
end

function g = new_maze(g)
  % STEP 14: Make random walls for the current level. 0 = Open grass path  1 = Hedge walls (obstacles)
  % Retry until a path from start to goal exists, so the level is always solvable.
  [density, extra] = level_settings(g.level);
  while true
    walls = rand(g.N) < density;              %position of the obstacles
    walls(g.start(1), g.start(2)) = 0;        % start point must be open grass
    walls(g.goal(1), g.goal(2)) = 0;          % goal must be open grass
    d = shortest_path(walls, g.start, g.goal);
    if d > 0                                  % d > 0 means a path exists
      break;
    end
  end
  g.walls = walls;
  % STEP 15: Step limit = shortest path + extra steps, so winning is always possible.
  g.maxsteps = d + extra;
end

function d = shortest_path(walls, start, goal)
  % STEP 16: Breadth-first search. Returns shortest path length, or -1 if none.
  N = size(walls, 1);
  dist = -ones(N);
  dist(start(1), start(2)) = 0;
  queue = start;
  moves = [1 0; -1 0; 0 1; 0 -1];
  while ~isempty(queue)
    cur = queue(1, :);
    queue(1, :) = [];
    for m = 1:4
      nxt = cur + moves(m, :);
      if all(nxt >= 1) && all(nxt <= N) && walls(nxt(1), nxt(2)) == 0 ...
         && dist(nxt(1), nxt(2)) == -1
        dist(nxt(1), nxt(2)) = dist(cur(1), cur(2)) + 1;
        queue(end+1, :) = nxt;
      end
    end
  end
  d = dist(goal(1), goal(2));
end

function g = reset_player(g)
  % STEP 17: Put the player back at the start with 0 steps used.
  g.player = g.start;
  g.steps = 0;
  g.mode = 'play';
end


%KEYBOARD HANDLE%
function on_key(src, evt)
  % STEP 18: Read the pressed key (as lowercase text).
  g = getappdata(src, 'g');
  key = evt.Key;
  if isempty(key), key = evt.Character; end
  if strcmp(key, ' '), key = 'space'; end
  if length(key) > 1 && strncmp(key, 'numpad', 6), key = key(end); end  % keypad numbers
  key = lower(key);
  k = get_keys(g.layout);

  % STEP 19: H goes back to the start screen, M opens the level menu.
  if strcmp(key, 'h') && ~strcmp(g.mode, 'intro')
    g.mode = 'intro';
    setappdata(src, 'g', g);
    show_intro(src);
    return;
  elseif strcmp(key, 'm') && ~strcmp(g.mode, 'menu')
    g.mode = 'menu';
    setappdata(src, 'g', g);
    show_menu(src);
    return;
  end

  switch g.mode
    case 'intro'
      % STEP 16: L switches keyboard layout, SPACE starts level 1.
      if strcmp(key, 'l')
        if strcmp(g.layout, 'AZERTY')
          g.layout = 'QWERTY';
        else
          g.layout = 'AZERTY';
        end
        setappdata(src, 'g', g);
        show_intro(src);
      elseif strcmp(key, 'space')
        g.level = 1;
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      end

    case 'menu'
      % STEP 20: Keys 1 to 5 start the chosen level with a new random maze.
      if any(strcmp(key, {'1', '2', '3', '4', '5'}))
        g.level = str2double(key);
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      end

    case 'play'
      % STEP 21: Movement keys move the player by exactly one cell.
      if strcmp(key, k.up),        d = [-1 0];
      elseif strcmp(key, k.down),  d = [1 0];
      elseif strcmp(key, k.left),  d = [0 -1];
      elseif strcmp(key, k.right), d = [0 1];
      else, return;
      end
      nxt = g.player + d;
      % A move is valid only if it stays inside the grid and is not a wall.
      if all(nxt >= 1) && all(nxt <= g.N) && g.walls(nxt(1), nxt(2)) == 0
        g.player = nxt;
        g.steps = g.steps + 1;
      end

      % STEP 22: WINNER if player arrives to the goal, LOOSER if there are no steps left.
      if isequal(g.player, g.goal)
        g.mode = 'end'; g.won = true;
        setappdata(src, 'g', g);
        if g.level < 5
          draw_game(src, 'WINNER!  R = again | N = new game | I = next level');
        else
          draw_game(src, 'WINNER! All levels done!  R = again | N = new game');
        end
      elseif g.steps >= g.maxsteps
        g.mode = 'end'; g.won = false;
        setappdata(src, 'g', g);
        draw_game(src, 'LOOSER  R = start again');
      else
        setappdata(src, 'g', g);
        draw_game(src, '');
      end

    case 'end'
      if strcmp(key, 'r')
        % STEP 23: R = same maze, player back to start.
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      elseif strcmp(key, 'n') && g.won
        % STEP 24: N = new random walls, same level, same start and goal.
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      elseif strcmp(key, 'i') && g.won && g.level < 5
        % STEP 25: I = go to the next level (only after a win).
        g.level = g.level + 1;
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      end
  end
end
