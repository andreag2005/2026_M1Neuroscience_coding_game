function maze_game()
  % STEP 1: Close any old game window (fixes blocking on the 2nd launch).
  close all force;
  try, graphics_toolkit('qt'); catch, end   % use qt if available, ignore if not

  % STEP 2: Fixed settings. Player starts at (1,1), goal is always at (10,10).
  g.N = 10;              % grid size (10 x 10)
  g.start = [1 1];       % start position [row column]
  g.goal = [10 10];      % goal position (always the same)
  g.extra = 4;           % extra steps allowed above the shortest path
  g.mode = 'intro';      % screens: 'intro', 'play', 'end'
  g.won = false;
  g.layout = 'AZERTY';   % keyboard layout: 'AZERTY' or 'QWERTY'

  % STEP 3: Create the window and connect the keyboard to on_key.
  fig = figure('Name', 'a-MAZE-ing', 'NumberTitle', 'off', 'MenuBar', 'none', ...
               'KeyPressFcn', @on_key);
  setappdata(fig, 'g', g);   % store the game state inside the window

  % STEP 4: Show the start screen.
  show_intro(fig);
end

function k = get_keys(layout)
  % STEP 5: Movement keys depend on the keyboard layout.
  % AZERTY: Z = up, Q = left, S = down, D = right.
  % QWERTY: W = up, A = left, S = down, D = right.
  if strcmp(layout, 'AZERTY')
    k.up = 'z'; k.left = 'q'; k.down = 's'; k.right = 'd';
  else
    k.up = 'w'; k.left = 'a'; k.down = 's'; k.right = 'd';
  end
end

function clear_fig(fig)
  % Remove everything drawn in the window but keep the keyboard connection.
  delete(get(fig, 'children'));
end

function show_intro(fig)
  % STEP 6: Start screen with title, credits and rules (keyboard only).
  g = getappdata(fig, 'g');
  k = get_keys(g.layout);
  up = upper(k.up); left = upper(k.left); down = upper(k.down); right = upper(k.right);
  clear_fig(fig);
  axes('Parent', fig, 'Position', [0 0 1 1]); axis off;
  text(0.5, 0.90, 'a-MAZE-ing', 'HorizontalAlignment', 'center', ...
       'FontSize', 28, 'FontWeight', 'bold');
  text(0.5, 0.81, 'Created by Andrea and Berenice', 'HorizontalAlignment', 'center', ...
       'FontSize', 12, 'FontAngle', 'italic');
  rules = {'RULES', ...
           '', ...
           sprintf('Move the red square with %s (up), %s (left), %s (down), %s (right).', up, left, down, right), ...
           'You move one step at a time.', ...
           'Black squares are walls: you cannot cross them.', ...
           'Reach the GREEN square before you run out of steps.', ...
           'If you reach it: WINNER!  If not: LOOSER.', ...
           'After a game: R = start again (same maze), N = new game (after a win).', ...
           '', ...
           sprintf('Keyboard: %s   (press L to switch AZERTY / QWERTY)', g.layout), ...
           '', ...
           'Press SPACE to start'};
  text(0.5, 0.42, rules, 'HorizontalAlignment', 'center', 'FontSize', 12);
  drawnow;
end

function g = new_maze(g)
  % STEP 7: Generate random walls. Retry until a path from start to goal exists.
  while true
    walls = rand(g.N) < 0.28;                 % about 28% of cells are walls
    walls(g.start(1), g.start(2)) = 0;        % start must be free
    walls(g.goal(1), g.goal(2)) = 0;          % goal must be free
    d = shortest_path(walls, g.start, g.goal);
    if d > 0                                  % d > 0 means a path exists
      break;
    end
  end
  g.walls = walls;
  % STEP 8: Step limit = shortest path + a few extra steps, so it is always possible.
  g.maxsteps = d + g.extra;
end

function d = shortest_path(walls, start, goal)
  % STEP 9: Breadth-first search. Returns shortest path length, or -1 if none.
  N = size(walls, 1);
  dist = -ones(N);
  dist(start(1), start(2)) = 0;
  queue = start;
  moves = [1 0; -1 0; 0 1; 0 -1];
  while ~isempty(queue)
    cur = queue(1, :);
    queue(1, :) = [];
    for m = 1:4
      nxt = cur + moves(m, :);
      if all(nxt >= 1) && all(nxt <= N) && walls(nxt(1), nxt(2)) == 0 ...
         && dist(nxt(1), nxt(2)) == -1
        dist(nxt(1), nxt(2)) = dist(cur(1), cur(2)) + 1;
        queue(end+1, :) = nxt;
      end
    end
  end
  d = dist(goal(1), goal(2));
end

function g = reset_player(g)
  % STEP 10: Put the player back at the start with 0 steps used.
  g.player = g.start;
  g.steps = 0;
  g.mode = 'play';
end

function draw_game(fig, msg)
  % STEP 11: Draw the grid. white = floor, black = wall,
  % light blue = start, green = goal, red = player.
  g = getappdata(fig, 'g');
  M = ones(g.N);                         % 1 = floor
  M(g.walls == 1) = 2;                   % 2 = wall
  M(g.start(1), g.start(2)) = 3;         % 3 = start
  M(g.goal(1), g.goal(2)) = 4;           % 4 = goal (different color)
  M(g.player(1), g.player(2)) = 5;       % 5 = player
  clear_fig(fig);
  axes('Parent', fig);
  image(M);
  colormap([1 1 1; 0 0 0; 0.6 0.8 1; 0 0.8 0; 1 0.2 0.2]);
  axis equal; axis off;
  title(sprintf('Steps left: %d   %s', g.maxsteps - g.steps, msg), 'FontSize', 14);
  drawnow;
end

function on_key(src, evt)
  % STEP 12: Read the pressed key (as lowercase text).
  g = getappdata(src, 'g');
  key = evt.Key;
  if isempty(key), key = evt.Character; end
  if strcmp(key, ' '), key = 'space'; end
  key = lower(key);
  k = get_keys(g.layout);

  switch g.mode
    case 'intro'
      % STEP 13: L switches the keyboard layout, SPACE starts the first level.
      if strcmp(key, 'l')
        if strcmp(g.layout, 'AZERTY')
          g.layout = 'QWERTY';
        else
          g.layout = 'AZERTY';
        end
        setappdata(src, 'g', g);
        show_intro(src);
      elseif strcmp(key, 'space')
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      end

    case 'play'
      % STEP 14: Movement keys (depend on layout) move the player by one cell.
      if strcmp(key, k.up),        d = [-1 0];
      elseif strcmp(key, k.down),  d = [1 0];
      elseif strcmp(key, k.left),  d = [0 -1];
      elseif strcmp(key, k.right), d = [0 1];
      else, return;
      end
      nxt = g.player + d;
      % A move is valid only if it stays inside the grid and is not a wall.
      if all(nxt >= 1) && all(nxt <= g.N) && g.walls(nxt(1), nxt(2)) == 0
        g.player = nxt;
        g.steps = g.steps + 1;
      end

      % STEP 15: WINNER if on the goal, LOOSER if no steps left.
      if isequal(g.player, g.goal)
        g.mode = 'end'; g.won = true;
        setappdata(src, 'g', g);
        draw_game(src, 'WINNER!  R = start again | N = new game');
      elseif g.steps >= g.maxsteps
        g.mode = 'end'; g.won = false;
        setappdata(src, 'g', g);
        draw_game(src, 'LOOSER  R = start again');
      else
        setappdata(src, 'g', g);
        draw_game(src, '');
      end

    case 'end'
      % STEP 16: R = same maze, player back to start.
      if strcmp(key, 'r')
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      % STEP 17: N = new random walls (only after a win), same start and goal.
      elseif strcmp(key, 'n') && g.won
        g = new_maze(g);
        g = reset_player(g);
        setappdata(src, 'g', g);
        draw_game(src, '');
      end
  end
end
